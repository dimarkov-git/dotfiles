{{/* Adding an account means copying this file and changing $want; chezmoi
   renders one source to one target.
*/ -}}
{{- $want := "work-secondary" -}}
{{- range (index . "gitAccounts" | default list) }}
{{- if eq .name $want -}}
[user]
	email = {{ .email }}
{{- if index . "userName" }}
	name = {{ .userName }}
{{- end }}
{{- with index . "signingKey" }}
	signingkey = {{ . }}
{{- end }}
{{- if index . "signingKey" }}

[commit]
	gpgsign = true

# Set even when it matches ~/.gitconfig: a key whose format disagrees with an
# inherited gpg.format fails at commit time, not at apply.
[gpg]
	format = {{ index . "signFormat" | default "ssh" }}
{{- end }}
{{- end }}
{{- end }}
