{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskOutput",
      "TaskStop",
      "LSP",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(mkfs:*)",
      "Bash(dd if=:*)",
      "Bash(sudo rm -rf:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.zshrc.secrets)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.cargo/credentials.toml)"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(git push:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl patch:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm rollback:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)",
      "Bash(mongosh:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null; then python3 ~/.claude/hooks/prose-check.py; else /opt/homebrew/bin/python3 ~/.claude/hooks/prose-check.py; fi",
            "timeout": 10,
            "statusMessage": "Checking prose rules..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-session-register.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-session-register.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-session-status.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-session-status.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Caches/go-build",
        "~/go/pkg/mod"
      ],
      "denyWrite": [
        "/usr",
        "/bin",
        "/sbin",
        "/etc",
        "/System",
        "/Library",
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.zshrc.secrets"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh",
        "~/.docker/config.json",
        "~/.cargo/credentials.toml",
        "~/.config/gcloud",
        "~/.kube/config",
        "~/.netrc",
        "~/.npmrc",
        "/etc/shadow",
        "~/.zshrc.secrets"
      ]
    },
    "excludedCommands": [
      "glab mr list*",
      "glab mr view*",
      "glab mr diff*",
      "glab mr note list*",
      "glab ci view*",
      "glab issue list*",
      "glab issue view*"
    ]
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true
}
