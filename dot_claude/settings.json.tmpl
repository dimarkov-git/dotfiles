{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskOutput",
      "TaskStop",
      "LSP",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(mkfs:*)",
      "Bash(dd if=:*)",
      "Bash(sudo rm -rf:*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.zshrc.secrets)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.cargo/credentials.toml)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl rollout:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl patch:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(helm rollback:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)",
      "Bash(mongosh:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null; then python3 ~/.claude/hooks/prose-check.py; else /opt/homebrew/bin/python3 ~/.claude/hooks/prose-check.py; fi",
            "timeout": 10,
            "statusMessage": "Checking prose rules..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-session-register.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-session-register.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|agent_needs_input|agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-notify.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-session-status.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-session-status.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "network": {
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/dev-zone",
        "~/.cache/buf",
        "~/Library/Caches/go-build",
        "~/Library/Caches/goimports",
        "~/Library/Caches/golangci-lint",
        "~/Library/Caches/gopls",
        "~/go/pkg/mod"
      ],
      "denyWrite": [
        "/usr",
        "/bin",
        "/sbin",
        "/etc",
        "/System",
        "/Library",
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.zshrc.secrets"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh",
        "~/.docker/config.json",
        "~/.cargo/credentials.toml",
        "~/.config/gcloud",
        "~/.kube/config",
        "~/.netrc",
        "~/.npmrc",
        "/etc/shadow",
        "~/.zshrc.secrets"
      ]
    },
    "excludedCommands": [
      "glab mr list*",
      "glab mr view*",
      "glab mr diff*",
      "glab mr note list*",
      "glab ci view*",
      "glab issue list*",
      "glab issue view*"
    ]
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-haiku-4-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "preferredNotifChannel": "notifications_disabled",
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Writing an internal hostname, private IP, work email or employer name into a file tracked by the public `~/dev-zone/dotfiles` repo — it goes in `~/.config/chezmoi/chezmoi.toml` behind a template guard instead",
      "`chezmoi apply` run bare, bypassing the drift guard in `make apply`",
      "Any write against a database, namespace or deployment target whose name carries `prod`{{ range index . "sensitiveTargetMarkers" | default list }} or `{{ . }}`{{ end }}"
    ],
    "environment": [
      "### Org-wide",
{{- if index . "autoModeOrg" }}
      "**Organization**: {{ index . "autoModeOrg" }}",
{{- else }}
      "**Organization**: None configured",
{{- end }}
      "**Repository visibility**: assume private unless a remote is a known public host (github.com/gitlab.com public project); internal forges are never queryable for visibility here",
      "**Internal sharing / snippet hosting**: None configured — public paste/gist services are outside the trust boundary",
      "**Secrets management**: 1Password (op-ssh-sign signs commits; no private key on disk). Never read or echo a secret to satisfy a task",
      "**Default / protected branches**: treat `main`, `master`, `develop`, `staging` and `production` as protected whatever the forge reports",
      "**Network posture**: ordinary developer laptop on an open internet connection; some internal hosts need the VPN up",
      "**Host containment**: none — commands run against the real machine, its real credentials and its real remotes",
{{- if index . "gitlabHost" }}
      "**Trusted internal domains**: {{ index . "gitlabHost" }}{{ if index . "extraGonosumdb" }}, {{ index . "extraGonosumdb" }}{{ end }}{{ if index . "dockerPhpRepo" }}, {{ (splitList "/" (index . "dockerPhpRepo")) | first }}{{ end }}",
      "**Internal package registry**: {{ index . "gitlabHost" }} (Go modules via GOPRIVATE){{ if index . "dockerPhpRepo" }}; {{ (splitList "/" (index . "dockerPhpRepo")) | first }} (docker images){{ end }}",
{{- else }}
      "**Trusted internal domains**: None configured",
      "**Internal package registry**: None configured",
{{- end }}
      "**Sensitive data locations & audiences**: `~/.config/chezmoi/chezmoi.toml` (this machine's private template data — internal hosts, IPs, work identities), `~/.ssh/`, `~/.aws/`, `~/.gnupg/`, `~/.zshrc.secrets`, `~/.claude/settings.local.json`, and any `.env*` in a working repo. Never paste their contents into a commit, an issue, a PR, or an outbound request",
      "**Sensitive remote targets**: any host, namespace, container or manifest whose name carries `prod`, `production`{{ range index . "sensitiveTargetMarkers" | default list }} or `{{ . }}`{{ end }} as a whole word or name segment",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota and node-pool resources, and anything tagged prod",
      "### User-specific",
      "**Primary use of Claude Code**: software development across several unrelated repos under `~/dev-zone` — a personal dotfiles repo and work services. The working scope is whichever repo is the cwd; other trees under `~/dev-zone` are someone else's context, not fair game",
      "**Public repo on this machine**: `~/dev-zone/dotfiles` is public. Anything identifying the employer, internal hosts or private IPs belongs in `~/.config/chezmoi/chezmoi.toml`, never in a file committed there",
      "**Shell**: Nushell is primary; Bash-tool commands run under zsh. BSD coreutils, no GNU twins"
    ]
  }
}
