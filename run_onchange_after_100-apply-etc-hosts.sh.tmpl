#!/usr/bin/env bash
# /etc/hosts is outside destDir and root:wheel, so chezmoi cannot manage it
# directly — `make apply` runs unprivileged.
#
# .tmpl because the source is itself a template: it is rendered inline below
# (a tempdir cwd makes sourceDir the only reliable path). The hash covers the
# rendered output, so a change to either the template or its data re-runs this.
# hosts-hash: {{ includeTemplate "etc/hosts.tmpl" . | sha256sum }}

set -euo pipefail

DST="/etc/hosts"
SRC="$(mktemp -t etc-hosts)"
trap 'rm -f "$SRC"' EXIT
cat >"$SRC" <<'HOSTS_EOF'
{{ includeTemplate "etc/hosts.tmpl" . }}
HOSTS_EOF

cmp -s "$SRC" "$DST" && exit 0

echo "/etc/hosts differs from the repo copy:"
diff -u "$DST" "$SRC" || true

# A declined password must not fail the apply chain: every other target already
# succeeded by this point.
if ! sudo -p "sudo password to update /etc/hosts (^C to skip): " \
        install -m 644 -o root -g wheel "$SRC" "$DST"; then
    echo "WARNING: /etc/hosts left unchanged. Re-run 'make apply' to retry." >&2
    exit 0
fi

# Resolution is cached; without a flush the old mapping survives.
sudo dscacheutil -flushcache 2>/dev/null || true
sudo killall -HUP mDNSResponder 2>/dev/null || true
echo "/etc/hosts updated."
