# Loaded BEFORE config.nu. Keep minimal — only what config.nu and autoload
# need already set. Everything else belongs in config.nu.

# VISUAL wins wherever both are read (git, gh): long-form editing goes to Zed,
# quick terminal edits and GUI-less sessions fall back to nano.
$env.EDITOR = "nano"
$env.VISUAL = "zed --wait"

# Pinned explicitly (defaults to ~/go) so gopls and dlv agree across machines.
$env.GOPATH = ($env.HOME | path join "go")

# k9s ignores XDG_CONFIG_HOME on macOS and defaults to
# ~/Library/Application Support/k9s. This moves config, aliases, skins and
# per-cluster state to the XDG path so one dot_config/k9s/ works on Linux too.
# Must stay in env.nu, not config.nu — k9s reads it from the environment at
# launch. run_onchange_after_03-install-k9s-skin.sh writes skins to the same
# path; keep the two in sync.
$env.K9S_CONFIG_DIR = ($env.HOME | path join ".config" "k9s")
{{- if index . "gitlabHost" }}
# Internal modules live behind auth — never proxy or sumcheck them publicly.
$env.GOPRIVATE = "{{ .gitlabHost }}"
$env.GONOSUMDB = "{{ .gitlabHost }}{{ if index . "extraGonosumdb" }},{{ .extraGonosumdb }}{{ end }}"
{{- end }}

# `path add` prepends, giving higher precedence.
use std/util "path add"
path add "/opt/homebrew/bin"
path add "/opt/homebrew/sbin"
path add "~/.local/bin"
path add "~/go/bin"
# krew installs kubectl plugins here; without it only kubectl-invoked ones work.
path add "~/.krew/bin"
# rustup is keg-only (conflicts with the `rust` formula), so its cargo/rustc
# shims aren't linked into /opt/homebrew/bin.
path add "/opt/homebrew/opt/rustup/bin"
path add "~/.cargo/bin"
path add "~/.orbstack/bin"
