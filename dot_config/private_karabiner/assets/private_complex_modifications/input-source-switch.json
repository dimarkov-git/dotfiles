{
  "title": "Layout switch",
  "rules": [
    {
      "description": "globe+z / globe+x to f18 / f19 (layout switch, handled by Hammerspoon)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "z",
            "modifiers": { "mandatory": ["fn"], "optional": ["caps_lock"] }
          },
          "to": [{ "key_code": "f18" }]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "x",
            "modifiers": { "mandatory": ["fn"], "optional": ["caps_lock"] }
          },
          "to": [{ "key_code": "f19" }]
        }
      ]
    }
  ]
}
