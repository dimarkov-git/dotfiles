{{/* ssh-keygen(1) ALLOWED SIGNERS format, not gitconfig. Signing works
   without this file; verifying does not — --show-signature reports "No
   signature" on commits git itself signed.

   One file for every identity: git matches on committer email, not on the
   active [includeIf]. namespaces="git" stops a signature made elsewhere from
   being replayed as a commit signature.
*/ -}}
{{- if and (index . "gitEmail") (index . "gitSigningKey") -}}
{{ index . "gitEmail" }} namespaces="git" {{ index . "gitSigningKey" }}
{{- end }}
{{- range (index . "gitAccounts" | default list) }}
{{- if and (index . "signingKey") (eq (index . "signFormat" | default "ssh") "ssh") }}
{{ .email }} namespaces="git" {{ .signingKey }}
{{- end }}
{{- end }}
